local aim_held = false
UIS.InputBegan:Connect(function(i,gpe) if not gpe and i.KeyCode==CFG.aimbot_key then aim_held=true end end)
UIS.InputEnded:Connect(function(i) if i.KeyCode==CFG.aimbot_key then aim_held=false end end)

RunService.RenderStepped:Connect(function()
    local center = screen_center()
    fov_circle.Visible  = CFG.aimbot_enabled
    fov_circle.Position = center

    if not CFG.aimbot_enabled then
        target_dot.Visible=false; pred_dot.Visible=false
        set_highlight(nil)
        return
    end

    local best_p, best_sp, best_pos = get_target()

    -- highlight
    if CFG.highlight_enabled then
        if best_p ~= current_target then
            set_highlight(best_p)
        end
    else
        set_highlight(nil)
    end

    if best_sp and best_pos then
        -- dot jaune sur position actuelle
        local raw_sp, raw_vis = Camera:WorldToViewportPoint(
            best_p and best_p.Character and (best_p.Character:FindFirstChild(CFG.aimbot_part) :: BasePart?) and
            (best_p.Character:FindFirstChild(CFG.aimbot_part) :: BasePart).Position or best_pos
        )
        if raw_vis then
            target_dot.Position=Vector2.new(raw_sp.X,raw_sp.Y); target_dot.Visible=true
        end

        -- dot bleu sur position prédite
        pred_dot.Position=best_sp; pred_dot.Visible=CFG.predict_enabled

        -- smooth aim vers position prédite
        if aim_held then
            local cur   = UIS:GetMouseLocation()
            local delta = (best_sp - cur) * CFG.aimbot_smooth
            mousemoverel(delta.X, delta.Y)
        end
    else
        target_dot.Visible=false; pred_dot.Visible=false
        if current_target then set_highlight(nil) end
    end
end)

