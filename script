-- ============================================================
--  VELOCITY TRACKER — pour la prédiction
--  Stocke la vélocité de chaque character sur les dernières frames
-- ============================================================
local vel_cache: {[Player]: Vector3} = {}
local pos_cache: {[Player]: Vector3} = {}

RunService.Heartbeat:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character; if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
        if not root then continue end
        local prev = pos_cache[p]
        if prev then
            vel_cache[p] = root.Position - prev
        end
        pos_cache[p] = root.Position
    end
end)

local function get_predicted_pos(p: Player, part: BasePart): Vector3
    if not CFG.predict_enabled then return part.Position end
    local vel = vel_cache[p]
    if not vel then return part.Position end
    -- calcule la distance caméra → cible pour estimer le temps de vol
    local cam = workspace.CurrentCamera
    local dist = (part.Position - cam.CFrame.Position).Magnitude
    -- plus la cible est loin, plus on prédit loin
    local frames = (dist / 300) / CFG.predict_factor * 8
    return part.Position + vel * frames
end

-- ============================================================
--  HIGHLIGHT — surligne la cible visée
-- ============================================================
local current_highlight: Highlight? = nil
local current_target: Player? = nil

local function set_highlight(p: Player?)
    -- retire l'ancien highlight
    if current_highlight then
        current_highlight:Destroy()
        current_highlight = nil
    end
    current_target = p
    if not p then return end
    local char = p.Character; if not char then return end
    local h = Instance.new("Highlight")
    h.FillColor        = Color3.fromRGB(255, 50, 50)
    h.OutlineColor     = Color3.fromRGB(255, 200, 50)
    h.FillTransparency = 0.4
    h.OutlineTransparency = 0
    h.Adornee          = char
    h.Parent           = char
    current_highlight  = h
end

-- update highlight si le character change
RunService.Heartbeat:Connect(function()
    if not current_highlight or not current_target then return end
    local char = current_target.Character
    if not char then set_highlight(nil); return end
    if current_highlight.Adornee ~= char then
        current_highlight.Adornee = char
    end
end)

Players.PlayerRemoving:Connect(function(p)
    if p == current_target then set_highlight(nil) end
end)

-- ============================================================
--  CAMERA
-- ============================================================
local Camera = workspace.CurrentCamera

local function screen_center(): Vector2
    local vp = Camera.ViewportSize
    return Vector2.new(vp.X/2, vp.Y/2)
end

local function is_enemy(p: Player): boolean
    if not LocalPlayer.Team then return true end
    return p.Team ~= LocalPlayer.Team
end

-- ============================================================
--  GET TARGET IN FOV (avec prédiction)
-- ============================================================
local function get_target(): (Player?, Vector2?, Vector3?)
    local center   = screen_center()
    local best_p: Player?   = nil
    local best_sp: Vector2? = nil
    local best_pos: Vector3? = nil
    local best_d            = CFG.aimbot_fov

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not is_enemy(p) then continue end
        local char = p.Character; if not char then continue end
        local part = char:FindFirstChild(CFG.aimbot_part) :: BasePart?
        local hum  = char:FindFirstChildOfClass("Humanoid")
        if not part or not hum or hum.Health <= 0 then continue end

        -- position prédite
        local pred_pos = get_predicted_pos(p, part)
        local sp, vis  = Camera:WorldToViewportPoint(pred_pos)
        if not vis then continue end

        local sp2 = Vector2.new(sp.X, sp.Y)
        local d   = (sp2 - center).Magnitude
        if d < best_d then
            best_d   = d
            best_p   = p
            best_sp  = sp2
            best_pos = pred_pos
        end
    end
    return best_p, best_sp, best_pos
end

