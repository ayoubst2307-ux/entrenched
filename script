local function slider(label: string, min_v: number, max_v: number, default: number, dec: boolean, cb: (number)->())
    local row = mk("Frame", {
        Size                   = UDim2.new(1,0,0,50),
        BackgroundColor3       = Color3.fromRGB(0,0,0),
        BackgroundTransparency = 0.5,
        BorderSizePixel        = 0,
    }, Content)
    mk("UICorner", { CornerRadius = UDim.new(0,8) }, row)
    local val_lbl = mk("TextLabel", {
        Size                   = UDim2.new(1,-12,0,20),
        Position               = UDim2.fromOffset(10,4),
        BackgroundTransparency = 1,
        Text                   = label .. ": " .. (dec and string.format("%.2f",default) or tostring(default)),
        TextColor3             = Color3.fromRGB(220,200,200),
        TextSize               = 11,
        Font                   = Enum.Font.Gotham,
        TextXAlignment         = Enum.TextXAlignment.Left,
    }, row)
    local track = mk("Frame", {
        Size                   = UDim2.new(1,-20,0,5),
        Position               = UDim2.fromOffset(10,32),
        BackgroundColor3       = Color3.fromRGB(35,8,8),
        BackgroundTransparency = 0.2,
        BorderSizePixel        = 0,
    }, row)
    mk("UICorner", { CornerRadius = UDim.new(1,0) }, track)
    local fill = mk("Frame", {
        Size             = UDim2.new((default-min_v)/(max_v-min_v),0,1,0),
        BackgroundColor3 = Color3.fromRGB(170,18,18),
        BorderSizePixel  = 0,
    }, track)
    mk("UICorner", { CornerRadius = UDim.new(1,0) }, fill)
    local drag = false
    track.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end end)
    UIS.InputChanged:Connect(function(i)
        if not drag or i.UserInputType~=Enum.UserInputType.MouseMovement then return end
        local rel = math.clamp((i.Position.X-track.AbsolutePosition.X)/track.AbsoluteSize.X,0,1)
        local v   = dec and math.floor((min_v+(max_v-min_v)*rel)*100)/100 or math.floor(min_v+(max_v-min_v)*rel)
        fill.Size = UDim2.new(rel,0,1,0)
        val_lbl.Text = label .. ": " .. (dec and string.format("%.2f",v) or tostring(v))
        cb(v)
    end)
end

